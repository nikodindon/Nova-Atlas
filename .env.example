# The YAML loader does NOT load .env files. Admin variables below are active in 01A.
# Keep all credentials empty; supply locally when the future adapters exist.
LLM_BASE_URL=
LITELLM_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
DATABASE_URL=
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
# Sprint 01A: read directly from the process environment (no automatic dotenv loader).
# Run python -m modules.web.admin_setup to generate .env.admin privately.
ATLAS_ADMIN_USERNAME=
ATLAS_ADMIN_PASSWORD_HASH=
ATLAS_SESSION_SECRET=
ATLAS_COOKIE_SECURE=1
# Comma-separated CIDRs of immediate reverse proxies; empty = no forwarded trust.
ATLAS_TRUSTED_PROXIES=
