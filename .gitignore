data/seen_hashes.json
data/article_processing.json
data/article-integrity.lock
# Préférences utilisateur (regénéré via UI, single-user pour l'instant)
data/preferences.json
data/processed_hashes.json
data/ollama.lock
data/ollama.lock.meta
data/llm-*.lock
data/llm-*.lock.meta

# Site généré
site/

