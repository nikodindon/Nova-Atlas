service:
  name: Nova Media
  tagline: Your personal AI news engine & radio
  default_language: fr
llm:
  provider: ollama
  model: qwen3:8b
  base_url: http://localhost:8080
  threads: 12
  timeout_fetch: 240
  timeout_report: 600
  timeout_edition: 900
  cache:
    enabled: true
    ttl_days: 7
rss:
  max_articles_per_feed: 3
  max_total_articles: 30
  live_window_hours: 20
radio:
  # Seuil de declenchement auto (watcher) : si N nouvelles news arrivent
  # depuis le dernier bulletin, on en genere un nouveau. Defaut 5.
  news_per_bulletin: 5
  # Cap d'articles collectes pour generer un bulletin (utilise par
  # main.py generate_bulletin). Avant 2026-07-28 etait hardcode a 20,
  # puis 40. Maintenant parametre. Defaut 40 = ~13-15 min de bulletin.
  max_articles_per_bulletin: 40
  # Nombre d'articles que le LLM doit TRAITER dans le bulletin (= combien
  # de news seront effectivement parlees). Le LLM recoit ~40 articles en
  # entree et en selectionne 9 pour les developper. Avant 2026-07-28
  # etait hardcode '4+3+2 = 9 articles uniques'. Maintenant parametre,
  # repartition automatique 45%/35%/20% sur les 3 news_block.
  # Exemples : 6 -> 3+2+1, 9 -> 4+3+2, 12 -> 5+4+3, 15 -> 7+5+3.
  articles_in_bulletin: 9
  news_interval_seconds: 30
  background_volume: 0.3
  voices:
