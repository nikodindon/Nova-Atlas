FROM ghcr.io/berriai/litellm:v1.108.0@sha256:c560d317136880ea92d62334d4367ab10955b1af189dd3ea24f6551290b1d6c1
WORKDIR /app
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DISABLE_ADMIN_UI=True LITELLM_TELEMETRY=False LITELLM_LOCAL_MODEL_COST_MAP=True
COPY deploy /app/deploy
COPY modules /app/modules
USER 10001:10001
ENTRYPOINT ["python", "-m", "deploy.gateway"]
CMD ["proxy"]
